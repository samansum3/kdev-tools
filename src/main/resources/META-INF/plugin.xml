<idea-plugin>
  <id>com.khalibre.tools</id>
  <name>K-Tools</name>
  <version>1.1.0</version>
  <vendor url="https://www.khalibre.com">Khalibre</vendor>

  <description><![CDATA[
        K-Tools brings PR creation/management, Jira ticket workflows, and daily standup
        reporting directly into the IDE — automating work that used to require switching
        between the terminal, GitHub, Jira, and Telegram.
    ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>

  <extensions defaultExtensionNs="com.intellij">

    <!-- Existing terminal link feature -->
    <consoleFilterProvider
      implementation="com.khalibre.tools.TerminalFilterProvider"/>

    <!-- New Dev Panel tool window -->
    <toolWindow
      id="K-Tools"
      anchor="right"
      secondary="false"
      canCloseContents="false"
      factoryClass="com.khalibre.tools.devpanel.DevPanelFactory"
      icon="/icons/khalibre-logo.png"/>

  </extensions>
</idea-plugin>
